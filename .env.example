# ==========================================
# Cyber Security Social Automation Bot Config
# ==========================================

# 1. Google Gemini AI API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Meta Graph API Credentials (Facebook & Instagram)
# Long-lived User Access Token or Page Access Token with:
# - pages_show_list, pages_read_engagement, pages_manage_posts
# - instagram_basic, instagram_content_publish
FB_ACCESS_TOKEN=your_meta_graph_api_access_token_here
FB_PAGE_ID=your_facebook_page_id_here
IG_USER_ID=your_instagram_business_account_id_here

# 3. Image Hosting for Instagram (Required because Instagram Graph API needs a public HTTPS URL)
# Get a free key in 30 seconds at: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_free_api_key_here

# 4. Optional Customization
CREATOR_HANDLE=@CyberSecurityHQ
DRY_RUN=false

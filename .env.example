# BBCC Skill Hub Daily Hindi News Automation
# Required for verified AI-assisted news summaries
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; default is gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Required only for live Facebook publishing
FB_ACCESS_TOKEN=your_meta_page_access_token_here
FB_PAGE_ID=your_facebook_page_id_here

# Optional: Instagram image publishing requires a connected professional account
# and a public image host key. Instagram publishing is skipped if IMGBB_API_KEY is absent.
IG_USER_ID=your_instagram_professional_account_id_here
IMGBB_API_KEY=your_imgbb_api_key_here

# Set true for safe local/manual testing; scheduled workflow explicitly sets false
DRY_RUN=true

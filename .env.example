# BBCC Skill Hub Daily Hindi News Automation
# Required for Gemini-assisted news generation
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Meta Graph API credentials for live publishing
# Page token should have the required Facebook Page publishing permissions.
FB_ACCESS_TOKEN=your_meta_graph_api_access_token_here
FB_PAGE_ID=your_facebook_page_id_here

# Optional Instagram professional account publishing
IG_USER_ID=your_instagram_business_account_id_here
# Public image hosting for Instagram image posts
IMGBB_API_KEY=your_imgbb_api_key_here

# Optional legacy compatibility settings
CREATOR_HANDLE=@BBCCSkillHub
ELEVENLABS_API_KEY=optional_legacy_setting

# Safe default for local/manual use. Scheduled workflow explicitly enables live mode.
DRY_RUN=true
